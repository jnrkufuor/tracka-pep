# The worker image: PyTorch, YOLO26, ffmpeg (~3-6 GB; PyTorch from PyPI includes CUDA,
# so the same image runs on a CPU or an NVIDIA GPU).
#
#   docker build -f Dockerfile.worker -t pep-worker .
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
ENV PYTHONPATH=/app
RUN useradd --create-home --uid 10001 pep

RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg libgl1 libglib2.0-0 \
 && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml README.md ./
RUN mkdir -p pep && touch pep/__init__.py && pip install ".[vision,coach,train]" && pip uninstall -y tracka-pep && rm -rf pep
COPY pep ./pep
COPY web ./web
COPY scripts ./scripts
RUN mkdir -p var/models && chown -R pep var
USER pep
# Download the model weights at BUILD time, so a new worker starts working immediately
# instead of downloading 30 MB on its first job (and so a GitHub outage can't stop workers).
ENV PEP_MODELS_DIR=/app/var/models
RUN cd var/models && python -c "from ultralytics import YOLO; YOLO('yolo26s.pt'); YOLO('yolo26n-pose.pt')"
CMD ["python", "-m", "pep.cli", "worker"]
