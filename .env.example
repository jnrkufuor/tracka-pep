# Copy to .env and fill in. Never commit .env (it's in .gitignore).
# Every variable is explained in pep/config.py.

# ---- shared with Tracka (must match tracka-api's values)
COACH_API_KEY=change-me-long-random-string
COACH_WEBHOOK_SECRET=change-me-another-long-random-string

# ---- local development
PEP_ENV=dev
PEP_INLINE_WORKER=true          # one process does everything: `pep serve`
PEP_LAB_PASSWORD=               # set one before putting the Lab on the internet

# ---- AI coach (optional; without it Pep writes rule-based notes)
GEMINI_API_KEY=
PEP_COACH_MODEL=gemini-3.8-flash

# ---- production database and storage (Render / Cloudflare R2)
# PEP_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/pep
# PEP_STORAGE=s3
# PEP_S3_BUCKET=pep-clips
# PEP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# PEP_S3_ACCESS_KEY=
# PEP_S3_SECRET_KEY=

# ---- reliability (docs/RUNBOOK.md)
# PEP_SENTRY_DSN=                # error tracking (Sentry or GlitchTip); empty = logs only
# PEP_BACKUP_BUCKET=pep-backups  # where scripts/backup.py --upload puts database copies

# ---- vision
# PEP_DETECTOR_MODEL=yolo26s.pt
# PEP_POSE_MODEL=yolo26n-pose.pt
# PEP_SAMPLES_PER_SECOND=10
# PEP_DEVICE=cuda:0
